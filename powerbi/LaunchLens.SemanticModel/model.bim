{
  "name": "LaunchLens",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "pt-BR",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "expressions": [
      {
        "name": "PastaDados",
        "kind": "m",
        "expression": "\"\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=false]"
      }
    ],
    "tables": [
      {
        "name": "Candidatos",
        "columns": [
          {
            "name": "app_id",
            "dataType": "string",
            "sourceColumn": "app_id",
            "summarizeBy": "none"
          },
          {
            "name": "nome_app",
            "dataType": "string",
            "sourceColumn": "nome_app",
            "summarizeBy": "none"
          },
          {
            "name": "data_avaliacao",
            "dataType": "dateTime",
            "sourceColumn": "data_avaliacao",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy"
          },
          {
            "name": "categoria",
            "dataType": "string",
            "sourceColumn": "categoria",
            "summarizeBy": "none"
          },
          {
            "name": "plataforma",
            "dataType": "string",
            "sourceColumn": "plataforma",
            "summarizeBy": "none"
          },
          {
            "name": "monetizacao",
            "dataType": "string",
            "sourceColumn": "monetizacao",
            "summarizeBy": "none"
          },
          {
            "name": "mercado_mil",
            "dataType": "double",
            "sourceColumn": "mercado_mil",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "crescimento_mercado",
            "dataType": "double",
            "sourceColumn": "crescimento_mercado",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "concorrentes",
            "dataType": "int64",
            "sourceColumn": "concorrentes",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "diferenciacao",
            "dataType": "double",
            "sourceColumn": "diferenciacao",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "nota_beta",
            "dataType": "double",
            "sourceColumn": "nota_beta",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "retencao_beta_d7",
            "dataType": "double",
            "sourceColumn": "retencao_beta_d7",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "ativacao_beta",
            "dataType": "double",
            "sourceColumn": "ativacao_beta",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "intencao_pagar",
            "dataType": "double",
            "sourceColumn": "intencao_pagar",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "preco_mensal",
            "dataType": "double",
            "sourceColumn": "preco_mensal",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "cac_estimado",
            "dataType": "double",
            "sourceColumn": "cac_estimado",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "custo_desenvolvimento",
            "dataType": "double",
            "sourceColumn": "custo_desenvolvimento",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "marketing_mensal",
            "dataType": "double",
            "sourceColumn": "marketing_mensal",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "experiencia_equipe",
            "dataType": "int64",
            "sourceColumn": "experiencia_equipe",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "prazo_meses",
            "dataType": "int64",
            "sourceColumn": "prazo_meses",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "prob_sucesso",
            "dataType": "double",
            "sourceColumn": "prob_sucesso",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "recomendacao",
            "dataType": "string",
            "sourceColumn": "recomendacao",
            "summarizeBy": "none"
          },
          {
            "name": "limiar_binario",
            "dataType": "double",
            "sourceColumn": "limiar_binario",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "limiar_adiar",
            "dataType": "double",
            "sourceColumn": "limiar_adiar",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "limiar_lancar",
            "dataType": "double",
            "sourceColumn": "limiar_lancar",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "ranking",
            "dataType": "int64",
            "sourceColumn": "ranking",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "dados_sinteticos",
            "dataType": "string",
            "sourceColumn": "dados_sinteticos",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Total candidatos",
            "expression": "COUNTROWS(Candidatos)",
            "formatString": "0",
            "displayFolder": "Indicadores LaunchLens"
          },
          {
            "name": "Probabilidade media",
            "expression": "AVERAGE(Candidatos[prob_sucesso])",
            "formatString": "0.0%",
            "displayFolder": "Indicadores LaunchLens"
          },
          {
            "name": "Lancar",
            "expression": "CALCULATE(COUNTROWS(Candidatos), Candidatos[recomendacao] = \"Lancar\")",
            "formatString": "0",
            "displayFolder": "Indicadores LaunchLens"
          },
          {
            "name": "Validar mais",
            "expression": "CALCULATE(COUNTROWS(Candidatos), Candidatos[recomendacao] = \"Validar mais\")",
            "formatString": "0",
            "displayFolder": "Indicadores LaunchLens"
          },
          {
            "name": "Adiar",
            "expression": "CALCULATE(COUNTROWS(Candidatos), Candidatos[recomendacao] = \"Adiar\")",
            "formatString": "0",
            "displayFolder": "Indicadores LaunchLens"
          },
          {
            "name": "Capital desenvolvimento",
            "expression": "SUM(Candidatos[custo_desenvolvimento])",
            "formatString": "\"R$ \"#,##0",
            "displayFolder": "Indicadores LaunchLens"
          }
        ],
        "partitions": [
          {
            "name": "Candidatos",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = if PastaDados = \"\" then Binary.FromText(\"\", BinaryEncoding.Base64)",
                "        else File.Contents(PastaDados & \"/candidatos_pontuados.csv\"),",
                "    CSV = Csv.Document(Fonte, [Delimiter=\",\", Columns=27, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(CSV, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"app_id\", type text}, {\"nome_app\", type text}, {\"data_avaliacao\", type date}, {\"categoria\", type text}, {\"plataforma\", type text}, {\"monetizacao\", type text}, {\"mercado_mil\", type number}, {\"crescimento_mercado\", type number}, {\"concorrentes\", Int64.Type}, {\"diferenciacao\", type number}, {\"nota_beta\", type number}, {\"retencao_beta_d7\", type number}, {\"ativacao_beta\", type number}, {\"intencao_pagar\", type number}, {\"preco_mensal\", type number}, {\"cac_estimado\", type number}, {\"custo_desenvolvimento\", type number}, {\"marketing_mensal\", type number}, {\"experiencia_equipe\", Int64.Type}, {\"prazo_meses\", Int64.Type}, {\"prob_sucesso\", type number}, {\"recomendacao\", type text}, {\"limiar_binario\", type number}, {\"limiar_adiar\", type number}, {\"limiar_lancar\", type number}, {\"ranking\", Int64.Type}, {\"dados_sinteticos\", type text}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "Avaliacao",
        "columns": [
          {
            "name": "app_id",
            "dataType": "string",
            "sourceColumn": "app_id",
            "summarizeBy": "none"
          },
          {
            "name": "nome_app",
            "dataType": "string",
            "sourceColumn": "nome_app",
            "summarizeBy": "none"
          },
          {
            "name": "data_avaliacao",
