            "sourceColumn": "fp",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "fn",
            "dataType": "int64",
            "sourceColumn": "fn",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "custo_relativo",
            "dataType": "double",
            "sourceColumn": "custo_relativo",
            "summarizeBy": "none",
            "formatString": "0.00"
          }
        ],
        "measures": [
          {
            "name": "Custo relativo",
            "expression": "MIN(Limiar[custo_relativo])",
            "formatString": "0.000",
            "displayFolder": "Indicadores LaunchLens"
          }
        ],
        "partitions": [
          {
            "name": "Limiar",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = if PastaDados = \"\" then Binary.FromText(\"\", BinaryEncoding.Base64)",
                "        else File.Contents(PastaDados & \"/sensibilidade_limiar.csv\"),",
                "    CSV = Csv.Document(Fonte, [Delimiter=\",\", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(CSV, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"limiar\", type number}, {\"fp\", Int64.Type}, {\"fn\", Int64.Type}, {\"custo_relativo\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      }
    ],
    "annotations": [
