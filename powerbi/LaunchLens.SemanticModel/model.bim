            "formatString": "0.00"
          },
          {
            "name": "experiencia_equipe",
            "dataType": "int64",
            "sourceColumn": "experiencia_equipe",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "prazo_meses",
            "dataType": "int64",
            "sourceColumn": "prazo_meses",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "data_desfecho",
            "dataType": "dateTime",
            "sourceColumn": "data_desfecho",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy"
          },
          {
            "name": "custo_total_12m",
            "dataType": "double",
            "sourceColumn": "custo_total_12m",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "receita_12m",
            "dataType": "double",
            "sourceColumn": "receita_12m",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "roi_12m",
            "dataType": "double",
            "sourceColumn": "roi_12m",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "sucesso_12m",
            "dataType": "int64",
            "sourceColumn": "sucesso_12m",
            "summarizeBy": "none",
