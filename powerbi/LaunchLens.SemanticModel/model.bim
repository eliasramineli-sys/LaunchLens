            "name": "monetizacao",
            "dataType": "string",
            "sourceColumn": "monetizacao",
            "summarizeBy": "none"
          },
          {
            "name": "mercado_mil",
            "dataType": "double",
            "sourceColumn": "mercado_mil",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "crescimento_mercado",
            "dataType": "double",
            "sourceColumn": "crescimento_mercado",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "concorrentes",
            "dataType": "int64",
            "sourceColumn": "concorrentes",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "diferenciacao",
            "dataType": "double",
            "sourceColumn": "diferenciacao",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "nota_beta",
            "dataType": "double",
            "sourceColumn": "nota_beta",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "retencao_beta_d7",
            "dataType": "double",
            "sourceColumn": "retencao_beta_d7",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "ativacao_beta",
            "dataType": "double",
            "sourceColumn": "ativacao_beta",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "intencao_pagar",
            "dataType": "double",
            "sourceColumn": "intencao_pagar",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "preco_mensal",
            "dataType": "double",
            "sourceColumn": "preco_mensal",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "cac_estimado",
            "dataType": "double",
            "sourceColumn": "cac_estimado",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "custo_desenvolvimento",
