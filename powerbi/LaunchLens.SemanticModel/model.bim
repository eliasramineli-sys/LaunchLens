            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "recall",
            "dataType": "double",
            "sourceColumn": "recall",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "f1",
            "dataType": "double",
            "sourceColumn": "f1",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "tn",
            "dataType": "int64",
            "sourceColumn": "tn",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "fp",
            "dataType": "int64",
            "sourceColumn": "fp",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "fn",
            "dataType": "int64",
            "sourceColumn": "fn",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "tp",
            "dataType": "int64",
            "sourceColumn": "tp",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "n",
            "dataType": "int64",
            "sourceColumn": "n",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "custo_relativo_por_app",
            "dataType": "double",
            "sourceColumn": "custo_relativo_por_app",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "limiar",
            "dataType": "double",
            "sourceColumn": "limiar",
            "summarizeBy": "none",
            "formatString": "0.00"
          }
        ],
        "measures": [
          {
            "name": "ROC AUC teste",
            "expression": "CALCULATE(MAX(Metricas[roc_auc]), Metricas[conjunto] = \"teste\")",
            "formatString": "0.000",
            "displayFolder": "Indicadores LaunchLens"
          },
          {
            "name": "Brier comparacao",
            "expression": "MIN(Metricas[brier])",
            "formatString": "0.000",
            "displayFolder": "Indicadores LaunchLens"
          }
        ],
        "partitions": [
          {
            "name": "Metricas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = if PastaDados = \"\" then Binary.FromText(\"\", BinaryEncoding.Base64)",
                "        else File.Contents(PastaDados & \"/metricas_modelos.csv\"),",
                "    CSV = Csv.Document(Fonte, [Delimiter=\",\", Columns=17, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(CSV, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"modelo\", type text}, {\"conjunto\", type text}, {\"roc_auc\", type number}, {\"pr_auc_ap\", type number}, {\"brier\", type number}, {\"log_loss\", type number}, {\"acuracia\", type number}, {\"precisao\", type number}, {\"recall\", type number}, {\"f1\", type number}, {\"tn\", Int64.Type}, {\"fp\", Int64.Type}, {\"fn\", Int64.Type}, {\"tp\", Int64.Type}, {\"n\", Int64.Type}, {\"custo_relativo_por_app\", type number}, {\"limiar\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "Importancia",
        "columns": [
          {
            "name": "variavel",
            "dataType": "string",
            "sourceColumn": "variavel",
            "summarizeBy": "none"
          },
          {
            "name": "importancia_auc",
            "dataType": "double",
            "sourceColumn": "importancia_auc",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "desvio_padrao",
            "dataType": "double",
            "sourceColumn": "desvio_padrao",
            "summarizeBy": "none",
            "formatString": "0.00"
          }
        ],
        "measures": [
          {
            "name": "Queda AUC",
            "expression": "SUM(Importancia[importancia_auc])",
            "formatString": "0.000",
            "displayFolder": "Indicadores LaunchLens"
          }
        ],
        "partitions": [
          {
            "name": "Importancia",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = if PastaDados = \"\" then Binary.FromText(\"\", BinaryEncoding.Base64)",
                "        else File.Contents(PastaDados & \"/importancia_variaveis.csv\"),",
                "    CSV = Csv.Document(Fonte, [Delimiter=\",\", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(CSV, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"variavel\", type text}, {\"importancia_auc\", type number}, {\"desvio_padrao\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "Limiar",
        "columns": [
          {
            "name": "limiar",
            "dataType": "double",
            "sourceColumn": "limiar",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "fp",
