          },
          {
            "name": "classe_modelo",
            "dataType": "string",
            "sourceColumn": "classe_modelo",
            "summarizeBy": "none"
          },
          {
            "name": "tp",
            "dataType": "int64",
            "sourceColumn": "tp",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "fp",
            "dataType": "int64",
            "sourceColumn": "fp",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "fn",
            "dataType": "int64",
            "sourceColumn": "fn",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "tn",
            "dataType": "int64",
            "sourceColumn": "tn",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "erro_brier",
            "dataType": "double",
            "sourceColumn": "erro_brier",
            "summarizeBy": "none",
            "formatString": "0.00"
          }
        ],
        "measures": [
          {
            "name": "Total teste",
            "expression": "COUNTROWS(Avaliacao)",
            "formatString": "0",
            "displayFolder": "Indicadores LaunchLens"
          },
          {
            "name": "Falsos positivos",
            "expression": "SUM(Avaliacao[fp])",
            "formatString": "0",
            "displayFolder": "Indicadores LaunchLens"
          },
          {
            "name": "Falsos negativos",
            "expression": "SUM(Avaliacao[fn])",
            "formatString": "0",
            "displayFolder": "Indicadores LaunchLens"
          },
          {
            "name": "Precisao",
            "expression": "DIVIDE(SUM(Avaliacao[tp]), SUM(Avaliacao[tp]) + SUM(Avaliacao[fp]))",
            "formatString": "0.0%",
            "displayFolder": "Indicadores LaunchLens"
          },
          {
            "name": "Recall",
            "expression": "DIVIDE(SUM(Avaliacao[tp]), SUM(Avaliacao[tp]) + SUM(Avaliacao[fn]))",
            "formatString": "0.0%",
            "displayFolder": "Indicadores LaunchLens"
          },
          {
            "name": "Brier filtrado",
            "expression": "AVERAGE(Avaliacao[erro_brier])",
            "formatString": "0.000",
            "displayFolder": "Indicadores LaunchLens"
          },
          {
            "name": "Taxa sucesso real",
            "expression": "AVERAGE(Avaliacao[sucesso_12m])",
            "formatString": "0.0%",
            "displayFolder": "Indicadores LaunchLens"
          }
        ],
        "partitions": [
          {
            "name": "Avaliacao",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = if PastaDados = \"\" then Binary.FromText(\"\", BinaryEncoding.Base64)",
                "        else File.Contents(PastaDados & \"/avaliacao_teste.csv\"),",
                "    CSV = Csv.Document(Fonte, [Delimiter=\",\", Columns=35, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(CSV, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"app_id\", type text}, {\"nome_app\", type text}, {\"data_avaliacao\", type date}, {\"categoria\", type text}, {\"plataforma\", type text}, {\"monetizacao\", type text}, {\"mercado_mil\", type number}, {\"crescimento_mercado\", type number}, {\"concorrentes\", Int64.Type}, {\"diferenciacao\", type number}, {\"nota_beta\", type number}, {\"retencao_beta_d7\", type number}, {\"ativacao_beta\", type number}, {\"intencao_pagar\", type number}, {\"preco_mensal\", type number}, {\"cac_estimado\", type number}, {\"custo_desenvolvimento\", type number}, {\"marketing_mensal\", type number}, {\"experiencia_equipe\", Int64.Type}, {\"prazo_meses\", Int64.Type}, {\"data_desfecho\", type date}, {\"custo_total_12m\", type number}, {\"receita_12m\", type number}, {\"roi_12m\", type number}, {\"sucesso_12m\", Int64.Type}, {\"prob_sucesso\", type number}, {\"classe_prevista\", Int64.Type}, {\"recomendacao\", type text}, {\"classe_real\", type text}, {\"classe_modelo\", type text}, {\"tp\", Int64.Type}, {\"fp\", Int64.Type}, {\"fn\", Int64.Type}, {\"tn\", Int64.Type}, {\"erro_brier\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "Metricas",
        "columns": [
          {
            "name": "modelo",
            "dataType": "string",
            "sourceColumn": "modelo",
            "summarizeBy": "none"
          },
          {
            "name": "conjunto",
            "dataType": "string",
            "sourceColumn": "conjunto",
            "summarizeBy": "none"
          },
          {
            "name": "roc_auc",
            "dataType": "double",
            "sourceColumn": "roc_auc",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "pr_auc_ap",
            "dataType": "double",
            "sourceColumn": "pr_auc_ap",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "brier",
            "dataType": "double",
            "sourceColumn": "brier",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "log_loss",
            "dataType": "double",
            "sourceColumn": "log_loss",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "acuracia",
            "dataType": "double",
            "sourceColumn": "acuracia",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "precisao",
            "dataType": "double",
